#pragma code_page(65001)
#include <windows.h>

IDI_ICON1 ICON "../images/vault.ico"

// Version numbers are passed in from CMake (PROJECT_VERSION) so this stays in sync with project()
#define AV_STR2(x) #x
#define AV_STR(x) AV_STR2(x)
#define AV_VERSION_STR AV_STR(AV_VERSION_MAJOR) "." AV_STR(AV_VERSION_MINOR) "." AV_STR(AV_VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
FILEVERSION     AV_VERSION_MAJOR,AV_VERSION_MINOR,AV_VERSION_PATCH,0
PRODUCTVERSION  AV_VERSION_MAJOR,AV_VERSION_MINOR,AV_VERSION_PATCH,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "AssetVault game asset browser"
            VALUE "FileVersion",      AV_VERSION_STR
            VALUE "InternalName",     "AssetVault"
            VALUE "LegalCopyright",   "Copyright (c) 2025 Luam Catão Totti"
            VALUE "OriginalFilename", "AssetVault.exe"
            VALUE "ProductName",      "AssetVault"
            VALUE "ProductVersion",   AV_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
